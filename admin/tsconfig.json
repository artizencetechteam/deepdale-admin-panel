{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "./vite.config.ts"],
  "exclude": ["../dist", "../node_modules"]
}
