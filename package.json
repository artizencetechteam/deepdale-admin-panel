{
  "name": "deepdale-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Deepdale CMS backend API",
  "license": "UNLICENSED",
  "scripts": {
    "dev:api": "tsx watch src/index.ts",
    "dev:admin": "vite --config admin/vite.config.ts",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:admin\"",
    "build:api": "prisma generate && node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build": "pnpm build:api && pnpm build:admin",
    "start": "prisma db push --accept-data-loss && pnpm prisma:ensure-admin && pnpm prisma:ensure-cms && node dist/index.js",
    "postinstall": "prisma generate",
    "test:api": "vitest run -c vitest.config.ts",
    "test:admin": "vitest run -c admin/vitest.config.ts",
    "test": "pnpm test:api && pnpm test:admin",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "openapi:write": "tsx scripts/write-openapi.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/0001_init/migration.sql",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:ensure-admin": "tsx prisma/ensure-admin.ts",
    "prisma:ensure-cms": "tsx prisma/ensure-cms.ts",
    "db:apply": "pnpm prisma db execute --file prisma/migrations/0001_init/migration.sql --schema prisma/schema.prisma",
    "verify:admin-persistence": "tsx scripts/verify-admin-persistence.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "multer": "^2.0.0",
    "openai": "^4.87.3",
    "prisma": "^6.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.1",
    "sanitize-html": "^2.14.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.22.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^7.3.1",
    "vitest": "^3.0.9"
  }
}
