# Server Configuration
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/deepdale"

# Auth & Sessions
SESSION_SECRET="change-me-to-a-32-character-random-string"
SESSION_COOKIE_NAME=dd_admin_session
CSRF_COOKIE_NAME=dd_admin_csrf
SESSION_TTL_HOURS=168

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Admin Seed Account (for initial setup)
ADMIN_SEED_EMAIL=admin@deepdale.local
ADMIN_SEED_PASSWORD=ChangeMe123!

# Storage (local or s3)
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads

# S3 Configuration (only if UPLOAD_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# AI & OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL_DEFAULT=gpt-4o-mini

# Text-to-Speech
TTS_PROVIDER=disabled
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
